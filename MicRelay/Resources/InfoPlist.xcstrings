{
  "sourceLanguage": "ja",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "System microphone permission prompt. Audio is processed locally.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のマイク音声を、イヤホン・HDMI機器などへリアルタイムに出力するために使用します。音声は保存・送信しません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output microphone audio to headphones, HDMI devices, or another enabled output on this device in real time. Audio is not saved or transmitted."
          }
        }
      }
    }
  },
  "version": "1.0"
}
