    "backup.help": {
      "comment": "Backup UI or status text. Keep format placeholders and units intact.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save gain, gain limit, EQ, audio mode, background settings, and the selected microphone to a JSON file. Audio is not included. Speaker permission and output confirmation are not restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲイン・ゲイン上限・EQ・音声モード・バックグラウンド設定・選択マイクをJSONファイルに保存します。音声は含みません。スピーカーの許可と接続先の確認は復元しません。"
          }
        }
      }
    },
