    "backup.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save gain, gain limit, EQ, wind reduction, audio mode, background settings, and the selected microphone to a JSON file. Audio is not included. Speaker permission and output confirmations are not restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲイン・ゲイン上限・EQ・風切り音低減・音声モード・バックグラウンド設定・選択マイクをJSONファイルに保存します。音声は含みません。スピーカーの許可と接続先の確認は復元しません。"
          }
        }
      }
    },
